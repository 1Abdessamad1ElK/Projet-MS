<?xml version="1.0" encoding="UTF-8"?>
<!--
  rail-bridge : pont CORBA -> REST (couche anti-corruption cote train).
  Java 8 + Spring Boot 2.7 (derniere ligne compatible Java 8) car JacORB 3.9
  a besoin de javax.rmi.CORBA, retire du JDK depuis Java 11 (voir ADR-004).
  L'IDL FOURNI est compile a la construction (jamais copie ni modifie) :
  ../rail-operator-corba/src/main/idl/rail.idl
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>ma.mobility</groupId>
  <artifactId>rail-bridge</artifactId>
  <version>1.0.0</version>

  <properties>
    <java.version>1.8</java.version>
    <jacorb.version>3.9</jacorb.version>
    <idl.out>${project.build.directory}/generated-sources/idl</idl.out>
    <idl.dir>${project.basedir}/../rail-operator-corba/src/main/idl</idl.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jacorb</groupId>
      <artifactId>jacorb</artifactId>
      <version>${jacorb.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jacorb</groupId>
      <artifactId>jacorb-omgapi</artifactId>
      <version>${jacorb.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jacorb</groupId>
      <artifactId>jacorb-idl-compiler</artifactId>
      <version>${jacorb.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- API OpenTelemetry : spans manuels autour de l'appel CORBA (no-op sans agent) -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <version>1.44.1</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>mkdir-idl-out</id>
            <phase>generate-sources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target><mkdir dir="${idl.out}"/></target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Stubs CORBA generes depuis l'IDL fourni (processus separe : le compilateur IDL appelle System.exit()) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>idl-compile</id>
            <phase>generate-sources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>java</executable>
              <classpathScope>compile</classpathScope>
              <arguments>
                <argument>-classpath</argument>
                <classpath/>
                <argument>org.jacorb.idl.parser</argument>
                <argument>-d</argument>
                <argument>${idl.out}</argument>
                <argument>-I${idl.dir}</argument>
                <argument>${idl.dir}/rail.idl</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-idl-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources><source>${idl.out}</source></sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
