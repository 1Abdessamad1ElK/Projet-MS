<?xml version="1.0" encoding="UTF-8"?>
<!--
  LOT 0 - Client CORBA de test (JDK 8).
  Meme mecanique que le pom du serveur fourni : l'IDL est compile par JacORB
  dans target/generated-sources/idl. On relit l'IDL FOURNI (jamais copie, jamais
  modifie) : ../../rail-operator-corba/src/main/idl/rail.idl

  Pourquoi Java 8 ? JacORB 3.9 a besoin de javax.rmi.CORBA, retire du JDK a partir
  de Java 11. Le bridge CORBA du Lot 1 devra donc tourner sur Java 8 (conteneur
  eclipse-temurin:8) - a justifier dans un ADR.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ma.mobility</groupId>
  <artifactId>rail-client</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <jacorb.version>3.9</jacorb.version>
    <idl.out>${project.build.directory}/generated-sources/idl</idl.out>
    <idl.dir>${project.basedir}/../../rail-operator-corba/src/main/idl</idl.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jacorb</groupId>
      <artifactId>jacorb</artifactId>
      <version>${jacorb.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jacorb</groupId>
      <artifactId>jacorb-omgapi</artifactId>
      <version>${jacorb.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jacorb</groupId>
      <artifactId>jacorb-idl-compiler</artifactId>
      <version>${jacorb.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>rail-client-${project.version}</finalName>
    <plugins>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>mkdir-idl-out</id>
            <phase>generate-sources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target><mkdir dir="${idl.out}"/></target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Generation des stubs a partir de l'IDL fourni (processus separe :
           le compilateur IDL appelle System.exit()). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>idl-compile</id>
            <phase>generate-sources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>java</executable>
              <classpathScope>compile</classpathScope>
              <arguments>
                <argument>-classpath</argument>
                <classpath/>
                <argument>org.jacorb.idl.parser</argument>
                <argument>-d</argument>
                <argument>${idl.out}</argument>
                <argument>-I${idl.dir}</argument>
                <argument>${idl.dir}/rail.idl</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-idl-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources><source>${idl.out}</source></sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <configuration>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
          <archive>
            <manifest>
              <mainClass>lot0.RailClient</mainClass>
            </manifest>
          </archive>
          <appendAssemblyId>true</appendAssemblyId>
        </configuration>
        <executions>
          <execution>
            <id>make-fatjar</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>
</project>
